<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sortir Foto Otomatis"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kelompokkan foto ke folder tanggal (EXIF / nama file)"
            android:textSize="13sp"
            android:textColor="#666666"
            android:layout_marginBottom="20dp" />

        <!-- FOLDER SUMBER -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1. Folder Sumber (bisa lebih dari satu)"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnTambahSumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+ Tambah Folder Sumber" />

        <LinearLayout
            android:id="@+id/layoutDaftarSumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp" />

        <!-- FOLDER TUJUAN -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2. Folder Tujuan"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnPilihTujuan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pilih Folder Tujuan" />

        <TextView
            android:id="@+id/tvFolderTujuan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Belum dipilih"
            android:textSize="13sp"
            android:textColor="#666666"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp" />

        <!-- FORMAT FOLDER -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3. Format Nama Folder Tanggal"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/radioGroupFormat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <RadioButton
                android:id="@+id/radioFormatDash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YYYY-MM-DD (contoh: 2026-09-12)"
                android:checked="true" />

            <RadioButton
                android:id="@+id/radioFormatPlain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YYYYMMDD (contoh: 20260912)" />
        </RadioGroup>

        <!-- FILTER RENTANG TANGGAL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4. Filter Rentang Tanggal (opsional)"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/checkboxFilterTanggal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aktifkan Filter Tanggal"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/layoutFilterTanggal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tanggal Mulai"
                android:textSize="13sp"
                android:textColor="#666666" />

            <Button
                android:id="@+id/btnTanggalMulai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pilih Tanggal Mulai"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tanggal Berakhir"
                android:textSize="13sp"
                android:textColor="#666666" />

            <Button
                android:id="@+id/btnTanggalAkhir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pilih Tanggal Berakhir" />

        </LinearLayout>

        <!-- TOMBOL PROSES -->
        <Button
            android:id="@+id/btnMulai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MULAI SORTIR"
            android:backgroundTint="#2E7D32"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <!-- LOG / RINGKASAN -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Log Proses"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:background="#F0F0F0"
            android:padding="10dp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>
</ScrollView>
